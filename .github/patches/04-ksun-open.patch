From 006414b2e15703a2d444d4600712428034cba900 Mon Sep 17 00:00:00 2001
From: blxizy <hidden@mail.local>
Date: Sun, 26 Jul 2026 18:43:16 +0300
Subject: [PATCH] Update open.c

---
 fs/open.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/fs/open.c b/fs/open.c
index b7e2889a710c..e033afc1097a 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -338,6 +338,12 @@ SYSCALL_DEFINE4(fallocate, int, fd, int, mode, loff_t, offset, loff_t, len)
 	return error;
 }
 
+#ifdef CONFIG_KSU
+__attribute__((hot))
+extern int ksu_handle_faccessat(int *dfd, const char __user **filename_user,
+				int *mode, int *flags);
+#endif
+
 /*
  * access() needs to use the real uid/gid, not the effective uid/gid.
  * We do this by temporarily clearing all FS-related capabilities and
@@ -353,6 +359,10 @@ SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 	int res;
 	unsigned int lookup_flags = LOOKUP_FOLLOW;
 
+#ifdef CONFIG_KSU
+	ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
+#endif
+
 	if (mode & ~S_IRWXO)	/* where's F_OK, X_OK, W_OK, R_OK? */
 		return -EINVAL;
 
